{
  "name": "fourproof-bnb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:pages": "npm run build && wrangler pages dev dist --ip 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run test && npm run build",
    "deploy": "npm run check && wrangler pages deploy dist --project-name fourproof-bnb"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
